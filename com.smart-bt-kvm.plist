<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smart-bt-kvm</string>

    <!-- Adjust the path if your username or install location differs.
         launchd does not expand ~ here. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pbodalia/bin/display-watcher</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/smart-bt-kvm.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/smart-bt-kvm.log</string>
</dict>
</plist>
